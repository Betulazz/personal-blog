# Native frontend development only. Docker uses the repository root template.
PUBLIC_SITE_URL=http://127.0.0.1:3000
# SSR-only backend origin. In production this may be an internal FastAPI URL.
NUXT_API_BASE=http://127.0.0.1:8000/api/v1
# Browser origin. Use /api/v1 behind the production reverse proxy.
NUXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1
