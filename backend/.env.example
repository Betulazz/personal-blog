# Native backend development only. Keep the real password in untracked .env.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=mysql+asyncmy://blog:replace-with-local-password@127.0.0.1:3306/personal_blog?charset=utf8mb4
TEST_DATABASE_URL=mysql+asyncmy://blog:replace-with-local-password@127.0.0.1:3306/personal_blog_test?charset=utf8mb4
# Optional admin connection to `mysql`; enables fresh test database recreation.
TEST_DATABASE_ADMIN_URL=mysql+asyncmy://root:replace-with-local-root-password@127.0.0.1:3306/mysql
DATABASE_ISOLATION_LEVEL="READ COMMITTED"
CORS_ORIGINS=["http://127.0.0.1:3000"]

# Authentication. Generate a unique value of at least 32 characters locally.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=personal-blog
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Local Media Asset storage. The path is relative to the backend process when
# it is not absolute; the public URL never exposes this filesystem path.
MEDIA_ROOT=uploads
MEDIA_PUBLIC_PREFIX=/uploads
MEDIA_STORAGE_STRATEGY=local
MEDIA_MAX_UPLOAD_BYTES=52428800
IMAGE_MAX_UPLOAD_BYTES=10485760
IMAGE_MAX_PIXELS=25000000
IMAGE_MAX_DIMENSION=10000

# NetEase requests use the approved anonymous website-endpoint fallback.
# Do not add AppID/AppSecret/PubKey/PrivateKey, account cookies, or QR tokens.
