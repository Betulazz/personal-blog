# Native backend development only. Keep the real password in untracked .env.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=mysql+asyncmy://blog:replace-with-local-password@127.0.0.1:3306/personal_blog?charset=utf8mb4
TEST_DATABASE_URL=mysql+asyncmy://blog:replace-with-local-password@127.0.0.1:3306/personal_blog_test?charset=utf8mb4
# Optional admin connection to `mysql`; enables fresh test database recreation.
TEST_DATABASE_ADMIN_URL=mysql+asyncmy://root:replace-with-local-root-password@127.0.0.1:3306/mysql
DATABASE_ISOLATION_LEVEL="READ COMMITTED"
CORS_ORIGINS=["http://127.0.0.1:3000"]
