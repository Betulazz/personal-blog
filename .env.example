# Application
APP_ENV=development
LOG_LEVEL=INFO

# Public URLs
PUBLIC_SITE_URL=http://localhost
NUXT_PUBLIC_API_BASE=/api/v1

# Database defaults for the Docker deployment template. Native development
# uses the per-process templates under backend/ and frontend/.
MYSQL_DATABASE=personal_blog
MYSQL_USER=blog
MYSQL_PASSWORD=replace-with-local-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
DATABASE_URL=mysql+asyncmy://blog:replace-with-local-password@mysql:3306/personal_blog?charset=utf8mb4

# Authentication (generate long random values for real deployments)
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# CORS, JSON encoded
CORS_ORIGINS=["http://localhost"]

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/app/uploads
LOCAL_STORAGE_PUBLIC_BASE=/uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
