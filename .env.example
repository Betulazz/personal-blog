# Docker deployment template. Copy to .env on the deployment host and replace
# every placeholder before starting the stack. Never commit the real file.
# Native development uses backend/.env.example and frontend/.env.example.
APP_ENV=production
LOG_LEVEL=INFO

# Public origin browsers use. Scheme included, no trailing slash.
PUBLIC_SITE_URL=https://blog.example.com

# The approved NetEase website-endpoint fallback uses anonymous fixed-origin
# requests; no NetEase account or application credentials are configured here.

# Database
MYSQL_DATABASE=personal_blog
MYSQL_USER=blog
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
DATABASE_URL=mysql+asyncmy://blog:replace-with-a-long-random-password@mysql:3306/personal_blog?charset=utf8mb4

# Authentication. Generate a unique value, for example: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=personal-blog
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Browser origins allowed to call the API directly, JSON encoded. Same-origin
# Nginx traffic does not need CORS; keep this limited to the public origin.
CORS_ORIGINS=["https://blog.example.com"]

# Host headers the backend accepts, JSON encoded. Must be explicit and must
# not contain "*" in production. Keep "backend" so the Nuxt server can call the
# API over the internal Compose network, and "127.0.0.1" for health checks.
TRUSTED_HOSTS=["blog.example.com", "127.0.0.1", "backend"]

# Trust X-Forwarded-* headers from the internal Docker network only.
FORWARDED_ALLOW_IPS=*

# Build-time package mirrors for restricted networks. The defaults reach the
# public registries; override them when the host cannot.
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
